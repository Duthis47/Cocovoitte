<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".Fragment.DriveOfferFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proposer un trajet"
            android:textColor="#1A237E"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:textAlignment="center" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lieu de départ"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_lieuDepart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: Paris"
                    android:inputType="text"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lieu d'arrivée"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_lieuArrivee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: Lyon"
                    android:inputType="text"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tarif par passager (€)"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_tarif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView17"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date de départ"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btn_choixDateDepart"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/editTextBackground"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_choixDateDepart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sélectionner une date"
                        android:drawableStart="@android:drawable/ic_menu_my_calendar"
                        android:drawablePadding="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Heure de départ"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btn_choixHeureDepart"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/editTextBackground"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_choixHeureDepart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sélectionner une heure"
                        android:drawableStart="@android:drawable/ic_menu_recent_history"
                        android:drawablePadding="8dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre de passagers"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/s_nbPassagers"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textView15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trajet régulier ?"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/s_trajetRegulier"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_freqH"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Fréquence hebdomadaire"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ToggleButton
                        android:id="@+id/btn_lundi"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:textOff="L"
                        android:textOn="L"
                        android:textSize="12sp" />

                    <ToggleButton
                        android:id="@+id/btn_mardi"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:textOff="M"
                        android:textOn="M"
                        android:textSize="12sp" />

                    <ToggleButton
                        android:id="@+id/btn_mercredi"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:textOff="M"
                        android:textOn="M"
                        android:textSize="12sp" />

                    <ToggleButton
                        android:id="@+id/btn_jeudi"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:textOff="J"
                        android:textOn="J"
                        android:textSize="12sp" />

                    <ToggleButton
                        android:id="@+id/btn_vendredi"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:textOff="V"
                        android:textOn="V"
                        android:textSize="12sp" />

                    <ToggleButton
                        android:id="@+id/btn_samedi"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:textOff="S"
                        android:textOn="S"
                        android:textSize="12sp" />

                    <ToggleButton
                        android:id="@+id/btn_dimanche"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E0E0E0"
                        android:textOff="D"
                        android:textOn="D"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_publier"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Publier le trajet"
            android:backgroundTint="#2E7D32"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>